# Local learning credentials only. setup-infra.ps1 generates a private .env.
MONGO_USER=card_servicing
MONGO_PASSWORD=GENERATE_ME
RABBITMQ_USER=card_servicing
RABBITMQ_PASSWORD=GENERATE_ME
MONGODB_DATABASE=card_servicing
# Full-stack Docker publishes MongoDB here; native debug services use this port.
MONGODB_HOST_PORT=27018
SQLITE_PATH=data/cards.db
CARD_STORE=sqlite
TELEMETRY_SINK=mongo
REDIS_URL=redis://127.0.0.1:6380/0
CARD_CACHE_TTL_SECONDS=60
# Used only to hash accounts in diagnostics; not used for SQLite storage.

ACCOUNT_HASH_KEY=GENERATE_ME
ACCOUNT_HASH_KEY_VERSION=v1

MONGODB_HOST=127.0.0.1
MONGODB_PORT=27018
RABBITMQ_PORT=5673
API_PORT=8011

# Conversational Agent AI Provider Settings
# For live Claude reasoning, set MODEL_PROVIDER=anthropic and supply your key:
MODEL_PROVIDER=anthropic
MODEL_ID=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=sk-ant-api03-...
# For local offline deterministic stub testing without an API key:
# MODEL_PROVIDER=stub
CARD_API_BASE_URL=http://127.0.0.1:8010
# Optional: defaults to src/card_chat/tools.json; OpenAPI path is relative to catalogue.
# TOOL_CATALOGUE_PATH=PATH_TO_LOCAL_TOOL_CATALOGUE
# Optional Anthropic static-prefix caching; off until measured. Compose forwards to Agent only.
ANTHROPIC_PROMPT_CACHE=false

# Live policies: ingest independently before starting the agent (docs/live-policy-runtime.md).
QDRANT_URL=http://127.0.0.1:6333
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
POLICY_VECTOR_STORE=qdrant
POLICIES_DIR=policies
POLICY_COLLECTION=banking_policies
POLICY_AUDIT_LOG=data/policy_audit.json

# Policy planning defaults; native/custom container environment settings.
# Standard Compose uses these defaults unless explicitly injected into cards-agent.
POLICY_CONTEXT_TOKENS=1250
POLICY_DEMO_DIGITAL_AVAILABLE=false
POLICY_DEMO_CASH_AVAILABLE=false

# Copy to .env.azure and replace placeholders. Never commit populated secrets.
COMPOSE_PROJECT_NAME=card-servicing-azure
TELEMETRY_SINK=azure_blob
AZURE_STORAGE_ACCOUNT_URL=https://YOURACCOUNT.blob.core.windows.net
AZURE_STORAGE_CONTAINER=telemetry
# Leave blank for VM managed identity (Storage Blob Data Contributor on container).
AZURE_CLIENT_ID=
# Alternative secure injected credential; leave blank for managed identity.
AZURE_STORAGE_CONNECTION_STRING=
PUBLIC_ORIGIN=https://bank.example.com
IDENTITY_PUBLIC_URL=https://login.example.com
OIDC_ISSUER=https://login.example.com/realms/cards
OIDC_AUTHORIZE_URL=https://login.example.com/realms/cards/protocol/openid-connect/auth
OIDC_JWKS_URL=http://identity:8080/realms/cards/protocol/openid-connect/certs
OIDC_TOKEN_URL=http://identity:8080/realms/cards/protocol/openid-connect/token
KEYCLOAK_SSL_REQUIRED=external
IDENTITY_CONFIG_DIR=./data/identity
POLICIES_HOST_DIR=./policies
STACK_MODEL_PROVIDER=anthropic
MODEL_ID=claude-sonnet-4-5
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
POLICY_VECTOR_STORE=qdrant
POLICY_COLLECTION=banking_policies
# Use the generated .env.stack values, matching the imported realm.
EXPERIENCE_SECRET=
AGENT_SECRET=
MCP_SECRET=
BROWSER_SECRET=
IDENTITY_ADMIN_PASSWORD=
ACCOUNT_HASH_KEY=
ACCOUNT_HASH_KEY_VERSION=v1
# Optional named-volume overrides (one service owns each SQLite volume).
AGENT_VOLUME=card-servicing-azure-agent
EXPERIENCE_VOLUME=card-servicing-azure-experience
CARDS_VOLUME=card-servicing-azure-cards
FINCRIME_VOLUME=card-servicing-azure-fincrime
IDENTITY_VOLUME=card-servicing-azure-identity
QDRANT_VOLUME=card-servicing-azure-qdrant

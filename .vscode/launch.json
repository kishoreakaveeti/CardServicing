{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Debug Full Stack (Local)",
      "preLaunchTask": "Prepare Local Stack",
      "configurations": [
        "Debug Local Experience API",
        "Debug Local Agent API",
        "Debug Local MCP Server",
        "Debug Local Cards API"
      ],
      "stopAll": true
    },
    {
      "name": "Debug Full Stack",
      "preLaunchTask": "Start Full Debug Stack",
      "configurations": [
        "Debug Frontend",
        "Attach to Experience API",
        "Attach to Agent API",
        "Attach to MCP Server",
        "Attach to Cards API"
      ],
      "stopAll": true
    },
    {
      "name": "Debug Full Stack (Docker)",
      "preLaunchTask": "Start Full Debug Stack",
      "configurations": [
        "Debug Frontend",
        "Attach to Experience API",
        "Attach to Agent API",
        "Attach to MCP Server",
        "Attach to Cards API"
      ],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Debug Frontend",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true
    },
    {
      "name": "Attach to Experience API",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5681
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/src",
          "remoteRoot": "/app/src"
        }
      ],
      "justMyCode": true
    },
    {
      "name": "Attach to Agent API",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5682
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/src",
          "remoteRoot": "/app/src"
        }
      ],
      "justMyCode": true
    },
    {
      "name": "Attach to MCP Server",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5683
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/src",
          "remoteRoot": "/app/src"
        }
      ],
      "justMyCode": true
    },
    {
      "name": "Attach to Cards API",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5684
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/src",
          "remoteRoot": "/app/src"
        }
      ],
      "justMyCode": true
    },
    {
      "name": "Debug Local Experience API",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/scripts/local_service.py",
      "args": [
        "experience"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false,
      "redirectOutput": true,
      "serverReadyAction": {
        "pattern": "Uvicorn running on http://127\\.0\\.0\\.1:8020",
        "action": "startDebugging",
        "name": "Debug Local Frontend",
        "killOnServerStop": true
      },
      "consoleName": "Local Experience API"
    },
    {
      "name": "Debug Local Agent API",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/scripts/local_service.py",
      "args": [
        "agent"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false,
      "consoleName": "Local Agent API"
    },
    {
      "name": "Debug Local MCP Server",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/scripts/local_service.py",
      "args": [
        "mcp"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false,
      "consoleName": "Local MCP Server"
    },
    {
      "name": "Debug Local Cards API",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/scripts/local_service.py",
      "args": [
        "cards"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false,
      "consoleName": "Local Cards API"
    },
    {
      "name": "Debug Local Frontend",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "presentation": {
        "hidden": true
      }
    }
  ]
}

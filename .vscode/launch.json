{
  "version": "0.2.0",
  "compounds": [{
    "name": "Debug Full Stack",
    "preLaunchTask": "Start Full Debug Stack",
    "configurations": ["Debug Frontend", "Attach to Experience API", "Attach to Agent API", "Attach to MCP Server", "Attach to Cards API"],
    "stopAll": true
  }],
  "configurations": [
    {"name": "Debug Frontend", "type": "chrome", "request": "launch", "url": "http://localhost:8080", "webRoot": "${workspaceFolder}/frontend", "sourceMaps": true},
    {"name": "Attach to Experience API", "type": "debugpy", "request": "attach", "connect": {"host": "127.0.0.1", "port": 5681}, "pathMappings": [{"localRoot": "${workspaceFolder}/src", "remoteRoot": "/app/src"}], "justMyCode": true},
    {"name": "Attach to Agent API", "type": "debugpy", "request": "attach", "connect": {"host": "127.0.0.1", "port": 5682}, "pathMappings": [{"localRoot": "${workspaceFolder}/src", "remoteRoot": "/app/src"}], "justMyCode": true},
    {"name": "Attach to MCP Server", "type": "debugpy", "request": "attach", "connect": {"host": "127.0.0.1", "port": 5683}, "pathMappings": [{"localRoot": "${workspaceFolder}/src", "remoteRoot": "/app/src"}], "justMyCode": true},
    {"name": "Attach to Cards API", "type": "debugpy", "request": "attach", "connect": {"host": "127.0.0.1", "port": 5684}, "pathMappings": [{"localRoot": "${workspaceFolder}/src", "remoteRoot": "/app/src"}], "justMyCode": true}
  ]
}
